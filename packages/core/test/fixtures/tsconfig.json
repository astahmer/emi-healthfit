{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@emi/core": ["./contracts/root.d.ts"],
      "@emi/core/server": ["./contracts/server.d.ts"],
      "@emi/core/server/effect": ["./contracts/server-effect.d.ts"],
      "@emi/core/server/fetch": ["./contracts/server-fetch.d.ts"],
      "@emi/core/styles.css": ["./contracts/styles.css.d.ts"],
      "@emi/core/*": ["./contracts/*.d.ts"]
    },
    "types": ["node"]
  },
  "include": ["consumers/**/*", "rewrite-gates/**/*"]
}
