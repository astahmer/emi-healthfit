{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@emi/core": ["./contracts/root.d.ts"],
      "@emi/core/server": ["./contracts/server.d.ts"],
      "@emi/core/server/tool-schema": ["./contracts/server-tool-schema.d.ts"],
      "@emi/core/server/database": ["./contracts/server-database.d.ts"],
      "@emi/core/server/effect": ["./contracts/server-effect.d.ts"],
      "@emi/core/server/fetch": ["./contracts/server-fetch.d.ts"],
      "@emi/core/styles.css": ["./contracts/styles.css.d.ts"],
      "@emi/core/api": ["./contracts/api.d.ts"],
      "@emi/core/chat": ["./contracts/chat.d.ts"],
      "@emi/core/advanced/xstate": ["./contracts/advanced-xstate.d.ts"],
      "@emi/core/adapters/ai-sdk": ["./contracts/adapters-ai-sdk.d.ts"],
      "@emi/core/adapters/cloudflare": ["./contracts/adapters-cloudflare.d.ts"],
      "@emi/core/components": ["./contracts/components.d.ts"],
      "@emi/core/components/styled": ["./contracts/components-styled.d.ts"],
      "@emi/core/discord": ["./contracts/discord.d.ts"],
      "@emi/core/extensions": ["./contracts/extensions.d.ts"],
      "@emi/core/protocol": ["./contracts/protocol.d.ts"],
      "@emi/core/react": ["./contracts/react.d.ts"],
      "@emi/core/runtime": ["./contracts/runtime.d.ts"],
      "@emi/core/server": ["./contracts/server.d.ts"],
      "@emi/core/server/effect": ["./contracts/server-effect.d.ts"],
      "@emi/core/server/fetch": ["./contracts/server-fetch.d.ts"],
      "@emi/core/testing": ["./contracts/testing.d.ts"],
      "@emi/core/web": ["./contracts/web.d.ts"]
    },
    "types": ["node"]
  },
  "include": ["consumers/**/*", "rewrite-gates/**/*"]
}
