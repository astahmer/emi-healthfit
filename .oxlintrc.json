{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "react", "react-perf", "unicorn", "effecttsgo"],
  "jsPlugins": ["./scripts/oxlint/emi-plugin.mjs"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "emi/no-abstract-domain-class": "error",
    "emi/no-empty-private-constructor": "error",
    "emi/no-generic-platform-import": "error",
    "emi/no-domain-effect-run": "error",
    "emi/no-effect-context-reprovide": "error",
    "emi/no-catch-if-tagged-error": "error",
    "emi/no-service-flat-map-facade": "error",
    "emi/no-effect-service-argument": "error",
    "emi/no-fallible-database-promise": "error",
    "emi/no-untyped-readable-stream-error": "error",
    "emi/no-export-forwarding": "error",
    "effecttsgo/any-unknown-in-error-context": "warn",
    "typescript/await-thenable": "off",
    "typescript/consistent-return": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-floating-promises": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off"
  },
  "ignorePatterns": [".next/**", ".alchemy/**", "dist/**", "coverage/**"]
}
