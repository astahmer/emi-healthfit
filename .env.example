BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:1337
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
ALLOWED_EMAILS=you@example.com

# 32-byte AES-GCM key for per-user Hevy API keys (hex or base64).
# Generate: openssl rand -hex 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEVY_CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-chars-or-32-byte-base64

# Optional: real Hevy Pro API key for live sync smoke tests.
# pnpm --filter @emi/api test:file test/hevy-live.integration.test.ts
# HEVY_API_KEY=

# Discord bot (apps/discord-bot). Create an application at
# https://discord.com/developers/applications to get these.
DISCORD_PUBLIC_KEY=replace-with-64-hex-char-ed25519-public-key
DISCORD_APPLICATION_ID=replace-with-discord-application-id
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
