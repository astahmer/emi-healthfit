# Copy this file to .env for the HealthFit API.
# API-only and built-SPA commands use http://localhost:1337. Chat hot reload creates a temporary
# environment with the UI origin.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:1337
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
ALLOWED_EMAILS=you@example.com
# Optional local-only headless auth for Playwright/MCP tools. Run `pnpm setup:agent-auth`.
# AGENT_AUTH_SECRET=replace-with-at-least-32-random-characters
# AGENT_AUTH_EMAIL=you@example.com

# 32-byte AES-GCM key for per-user Hevy API credentials.
# Generate: openssl rand -hex 32
HEVY_CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters

# OpenAI key used by the API Worker for chat and Discord /ask generation.
OPENAI_API_KEY=sk-replace-with-openai-api-key

# Shared secret between the Discord bot and API (at least 16 random characters).
DISCORD_INTERNAL_ASK_SECRET=replace-with-at-least-16-random-characters
