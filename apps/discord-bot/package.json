{
  "name": "@emi/discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "alchemy deploy",
    "deploy:adopt": "alchemy deploy --adopt",
    "deploy:prod": "alchemy deploy --stage prod --env-file .env",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "dry": "alchemy deploy --dry-run",
    "dry:adopt": "alchemy deploy --dry-run --adopt",
    "register": "node --experimental-strip-types scripts/register-commands.ts",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "test:file": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@emi/core": "workspace:*",
    "@emi/core": "workspace:*",
    "@emi/flavor-healthfit": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "miniflare": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
