{
  "name": "@emi/generic-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "dry": "alchemy deploy --dry-run",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "test:file": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@emi/core": "workspace:*",
    "alchemy": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "kysely": "catalog:",
    "kysely-d1": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "miniflare": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
