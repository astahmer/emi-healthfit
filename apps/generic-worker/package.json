{
  "name": "@emi/generic-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "dry": "alchemy deploy --dry-run",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "test:file": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@emi/core-server": "workspace:*",
    "@emi/platform-cloudflare": "workspace:*",
    "alchemy": "2.0.0-beta.59",
    "drizzle-orm": "0.45.2",
    "effect": "catalog:",
    "kysely": "0.29.3",
    "kysely-d1": "0.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250805.0",
    "@types/node": "^26.0.0",
    "drizzle-kit": "0.31.10",
    "miniflare": "4.20260710.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "wrangler": "^4.111.0"
  }
}
