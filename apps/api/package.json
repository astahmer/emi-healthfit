{
  "name": "@emi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "alchemy deploy",
    "deploy:prod": "alchemy deploy --stage prod --env-file ../../.env.prod --yes",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:ownership:review": "node --experimental-strip-types scripts/review-owner-migration.ts",
    "dry": "alchemy deploy --dry-run",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "test:file": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "setup:google": "node scripts/setup-google-auth.mjs",
    "setup:hevy-key": "node scripts/ensure-hevy-encryption-key.mjs",
    "verify": "node --experimental-strip-types scripts/verify-parsers.ts",
    "hevy:openapi": "node --experimental-strip-types scripts/fetch-hevy-openapi.ts",
    "hevy:client": "node --experimental-strip-types scripts/generate-hevy-client.ts",
    "hevy:reset-from-api": "node --experimental-strip-types scripts/reset-hevy-from-api.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@emi/core": "workspace:*",
    "@emi/core-migration": "workspace:*",
    "@emi/flavor-healthfit": "workspace:*",
    "ai": "catalog:",
    "alchemy": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "kysely": "catalog:",
    "kysely-d1": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-node": "catalog:",
    "@types/json-schema": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "miniflare": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typed-openapi": "2.2.7",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
