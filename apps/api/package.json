{
  "name": "@emi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "alchemy deploy",
    "deploy:prod": "alchemy deploy --stage prod --env-file ../../.env.prod",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:ownership:review": "node --experimental-strip-types scripts/review-owner-migration.ts",
    "dry": "alchemy deploy --dry-run",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "test:file": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "setup:google": "node scripts/setup-google-auth.mjs",
    "verify": "node --experimental-strip-types scripts/verify-parsers.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@emi/api-contract": "workspace:*",
    "ai": "catalog:",
    "alchemy": "2.0.0-beta.59",
    "better-auth": "catalog:",
    "drizzle-orm": "0.45.2",
    "effect": "catalog:",
    "kysely": "0.29.3",
    "kysely-d1": "0.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250805.0",
    "@effect/platform-node": "4.0.0-beta.88",
    "@types/json-schema": "catalog:",
    "@types/node": "^26.0.0",
    "drizzle-kit": "0.31.10",
    "miniflare": "4.20260710.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "wrangler": "^4.111.0"
  }
}
