{
  "name": "@emi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "dry": "alchemy deploy --dry-run",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "verify": "node --experimental-strip-types scripts/verify-parsers.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "ai": "catalog:",
    "alchemy": "2.0.0-beta.59",
    "drizzle-orm": "0.45.2",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250805.0",
    "@effect/platform-node": "4.0.0-beta.88",
    "@types/json-schema": "catalog:",
    "drizzle-kit": "0.31.10",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
