{
  "name": "emi-healthfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "pnpm --filter api deploy",
    "destroy": "pnpm --filter api destroy",
    "dev": "pnpm --filter api dev",
    "dry": "pnpm --filter api dry",
    "alchemy": "pnpm --dir apps/api run alchemy",
    "alchemy:login": "pnpm --dir apps/api run alchemy:login",
    "alchemy:profile": "pnpm --dir apps/api run alchemy:profile",
    "test": "pnpm --filter @emi/core build && pnpm -r test",
    "coverage:check": "pnpm release:tests",
    "release:tests": "turbo run test:release --filter='./apps/*' --filter='./packages/*' --concurrency=3",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm slop:check && pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "knip": "knip",
    "format": "pnpm -r format",
    "format:fix": "pnpm -r format:fix",
    "fmt": "pnpm -r format:fix",
    "release:check": "node scripts/release-check.mjs",
    "release:check:lowram": "RELEASE_CONCURRENCY=2 VITEST_MAX_WORKERS=2 PLAYWRIGHT_WORKERS=3 pnpm release:check",
    "check:fast": "node scripts/release-check.mjs --fast",
    "check:affected": "node scripts/release-check.mjs --affected",
    "check:smoke": "node scripts/release-check.mjs --stage smoke",
    "check:unit": "node scripts/release-check.mjs --stage unit",
    "check:static": "node scripts/release-check.mjs --stage static",
    "check:tests": "node scripts/release-check.mjs --stage tests",
    "check:verify": "node scripts/release-check.mjs --stage verify",
    "check:schema": "node scripts/release-check.mjs --stage schema",
    "check:generated": "node scripts/release-check.mjs --stage generated",
    "check:e2e": "node scripts/release-check.mjs --stage e2e",
    "release": "node scripts/release.mjs",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "verify": "pnpm --filter api verify",
    "verify:chat-app": "pnpm --filter @emi/create-chat-app test:generated",
    "build": "pnpm -r build",
    "setup:google": "pnpm --filter api setup:google",
    "setup:agent-auth": "pnpm --dir apps/api setup:agent-auth",
    "auth:agent": "pnpm --dir apps/api auth:agent",
    "chat:dev": "node scripts/run-healthfit-chat-dev.mjs",
    "chat:dev:ui": "pnpm --dir apps/chat dev",
    "dev:apps": "node scripts/run-dev-apps.mjs",
    "chat:build": "pnpm --filter chat build && pnpm --filter chat build:assets",
    "models:check": "node scripts/update-openai-models.mjs --check",
    "models:update": "node scripts/update-openai-models.mjs --write",
    "generic:dev": "node scripts/run-generic-dev.mjs",
    "generic:worker:dev": "pnpm --filter @emi/generic-worker dev",
    "generic:web:dev": "pnpm --filter @emi/generic-web dev",
    "fixture:chat-app": "node --experimental-strip-types scripts/generate-chat-app-fixture.mjs",
    "discord:dev": "pnpm --filter @emi/discord-bot dev",
    "discord:deploy": "pnpm --filter @emi/discord-bot deploy",
    "discord:deploy:adopt": "pnpm --filter @emi/discord-bot deploy:adopt",
    "discord:deploy:prod": "pnpm --filter @emi/discord-bot deploy:prod",
    "discord:register": "pnpm --filter @emi/discord-bot register",
    "discord:setup:check": "pnpm --filter @emi/discord-bot test:file test/setup-check.test.ts",
    "slop:check": "node scripts/check-architecture-boundaries.mjs && node scripts/check-schema-effect-antislop.mjs && node scripts/check-actor-test-pairs.mjs && node scripts/run-ast-grep.mjs scan && node scripts/check-oxlint-antislop.mjs",
    "slop:test": "node scripts/run-ast-grep.mjs test --skip-snapshot-tests",
    "diagnose:session": "node --experimental-strip-types apps/api/scripts/diagnose-session.ts"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.0",
    "@effect/tsgo": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "2.10.9",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.18.0"
}
