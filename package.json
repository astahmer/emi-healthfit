{
  "name": "emi-healthfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "pnpm --filter api deploy",
    "destroy": "pnpm --filter api destroy",
    "dev": "pnpm --filter api dev",
    "dry": "pnpm --filter api dry",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm slop:check && pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "knip": "knip",
    "format": "pnpm -r format",
    "format:fix": "pnpm -r format:fix",
    "fmt": "pnpm -r format:fix",
    "release:check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm verify && pnpm verify:chat-app && pnpm --filter @emi/api db:check && pnpm --filter @emi/chat test:e2e",
    "release": "node scripts/release.mjs",
    "verify": "pnpm --filter api verify",
    "verify:chat-app": "pnpm --filter @emi/create-chat-app test:generated",
    "build": "pnpm -r build",
    "setup:google": "pnpm --filter api setup:google",
    "dev:portless": "node scripts/run-healthfit-portless-dev.mjs",
    "chat:dev": "pnpm --filter chat dev",
    "chat:dev:portless": "API_BASE_URL=https://emi-healthfit.localhost pnpm exec portless --name emi-chat -- pnpm --dir apps/chat exec vite --host 127.0.0.1",
    "chat:build": "pnpm --filter chat build",
    "models:check": "node scripts/update-openai-models.mjs --check",
    "models:update": "node scripts/update-openai-models.mjs --write",
    "generic:dev": "node scripts/run-generic-dev.mjs",
    "generic:dev:portless": "node scripts/run-generic-portless-dev.mjs",
    "generic:worker:dev": "pnpm --filter @emi/generic-worker dev",
    "generic:web:dev": "pnpm --filter @emi/generic-web dev",
    "fixture:chat-app": "node --experimental-strip-types scripts/generate-chat-app-fixture.mjs",
    "discord:dev": "pnpm --filter @emi/discord-bot dev",
    "discord:deploy": "pnpm --filter @emi/discord-bot deploy",
    "discord:deploy:adopt": "pnpm --filter @emi/discord-bot deploy:adopt",
    "discord:deploy:prod": "pnpm --filter @emi/discord-bot deploy:prod",
    "discord:register": "pnpm --filter @emi/discord-bot register",
    "discord:setup:check": "pnpm --filter @emi/discord-bot test:file test/setup-check.test.ts",
    "slop:check": "node scripts/check-architecture-boundaries.mjs && node scripts/check-schema-effect-antislop.mjs && node scripts/run-ast-grep.mjs scan && node scripts/check-oxlint-antislop.mjs",
    "slop:test": "node scripts/run-ast-grep.mjs test --skip-snapshot-tests",
    "diagnose:session": "node --experimental-strip-types apps/api/scripts/diagnose-session.ts",
    "portless:doctor": "pnpm exec portless doctor"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.44.1",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "portless": "catalog:",
    "typescript": "catalog:"
  }
}
